{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kob model setup profile (.kaidf/model-setup.json)",
  "description": "A declarative profile in three layers: the profile itself, the RAG context layer, and the QLoRA weights layer. Canonical copy; agent-aidf ships an identical copy (tests keep them equal).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "mood"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "identity": {
      "type": "string",
      "maxLength": 2000
    },
    "mood": {
      "enum": ["pragmatic-auditor", "strict-auditor", "socratic-mentor"]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 32768},
        "context_window": {"type": "integer", "minimum": 512, "maximum": 131072}
      }
    },
    "custom_instructions": {
      "type": "string",
      "maxLength": 4000
    },
    "rag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {"path": {"type": "string", "minLength": 1}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["url"],
                "properties": {"url": {"type": "string", "pattern": "^https?://"}}
              }
            ]
          }
        },
        "allowed_url_hosts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "top_k": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_context_chars": {"type": "integer", "minimum": 200, "maximum": 40000}
      }
    },
    "qlora": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "base_model": {"type": "string", "minLength": 1},
        "adapter_path": {"type": "string", "minLength": 1},
        "quantization": {"enum": ["nf4"]},
        "lora_config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "r": {"type": "integer", "minimum": 1, "maximum": 256},
            "alpha": {"type": "integer", "minimum": 1, "maximum": 512},
            "dropout": {"type": "number", "minimum": 0, "maximum": 0.5},
            "target_modules": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "dataset_manifest": {"type": "string", "pattern": "\\.jsonl$"},
        "fallback_to_base": {"type": "boolean"}
      },
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"required": ["base_model", "adapter_path", "dataset_manifest"]}
    }
  }
}
