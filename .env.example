# Workspace defaults
KAIDF_GENERATED_REPO=

# Agent chat controller
# AIDF_CHAT_PROVIDER forces which backend build_controller() uses: "openai",
# "ollama", or "none" (stub, no AI). Leave unset for the default: kob is
# local-first, so it always uses "ollama" unless you set this to "openai" —
# merely having OPENAI_API_KEY set below is NOT enough by itself to switch to
# the cloud (this avoids a leftover/ambient key silently diverting kob).
AIDF_CHAT_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1
AIDF_CHAT_INSTRUCTIONS=
# How long (seconds) kob waits for a chat/mentor reply before giving up.
# Default is 300s; raise this on slower/CPU-only machines if you see
# "did not respond within Ns" on otherwise-healthy requests.
AIDF_CHAT_TIMEOUT_SECONDS=

# Local inference (Ollama/OLMo) — OLLAMA_HOST, AIDF_MODEL, and
# KAIDF_LOCAL_INFERENCE are populated automatically by `make workspace-up`,
# which also picks AIDF_MODEL based on this machine's RAM/disk/GPU.
KAIDF_LOCAL_INFERENCE=
OLLAMA_HOST=
AIDF_MODEL=
# Force a specific Ollama model tag instead of hardware auto-detection
# (read by scripts/detect-ollama-model.sh, used by `make workspace-up`).
AIDF_OLLAMA_MODEL=

# MCP server
SECRET_KEY=change-me
