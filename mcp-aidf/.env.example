# Copy to .env and fill in before `docker compose up`.
# Both values are required by docker-compose.yml.
SECRET_KEY=change-me-to-a-long-random-value
MCP_BEARER_TOKEN=change-me-to-a-long-random-token
# Optional: extra tokens limited to namespaces, as a JSON object. Leave empty for none.
# MCP_TOKEN_SCOPES={"<tenant-token>": ["tenant-a"]}
# Optional: public base URL clients reach this server at; published in the 401 challenge and
# protected-resource metadata. Unset, it defaults to http://localhost:7777.
# MCP_PUBLIC_URL=https://mcp.example.org
